{
  "name": "dsh-remote-workbench",
  "version": "0.2.2",
  "description": "极其顺手的 AI 远程工作台 · DSH 原生右侧栏、SSH/SFTP、监控与 PDF 编辑",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.3 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "prepack": "npm run build",
    "test:dsh": "tsx scripts/verify-dsh.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.2",
    "dompurify": "^3.4.18",
    "esbuild": "^0.25.12",
    "lucide-react": "^0.468.0",
    "marked": "^18.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh",
    "sftp",
    "remote-workbench",
    "monitoring",
    "pdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freakz2z/dsh-remote-workbench.git"
  },
  "homepage": "https://github.com/Freakz2z/dsh-remote-workbench#readme",
  "bugs": {
    "url": "https://github.com/Freakz2z/dsh-remote-workbench/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
